# Copy to .env and fill in once you create a free project at https://supabase.com
# The app runs fully offline on mock data + on-device storage if these are left unset.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key is only used by the one-off seed/photo scripts under supabase/scripts,
# never by the app itself. Never commit it or prefix it with EXPO_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
